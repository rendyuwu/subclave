{
  "name": "subclave",
  "private": true,
  "version": "0.1.0",
  "description": "Subclave - a local-first desktop password manager.",
  "author": "rendyuwu",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rendyuwu/subclave.git"
  },
  "homepage": "https://github.com/rendyuwu/subclave",
  "bugs": {
    "url": "https://github.com/rendyuwu/subclave/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "lint:imports": "node scripts/check-imports.mjs",
    "verify": "node scripts/verify-all.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,json,md}\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,tsx,js,jsx,css,json,md,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,json,md}\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,tsx,js,jsx,css,json,md,html}\"",
    "lint:rust": "cd src-tauri && cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings",
    "fmt:rust": "cd src-tauri && cargo fmt --all",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.12.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-doctor": "^0.2.14",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vite": "^8.1.4"
  }
}
