{
  "name": "subclave-extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Subclave browser integration: the MV3 extension.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --test && node scripts/build.mjs --test --no-content",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build:e2e && playwright test --config test/playwright.config.ts",
    "zip": "node scripts/zip.mjs",
    "lint:webext": "web-ext lint --source-dir dist/firefox"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "vite": "^8.1.4",
    "web-ext": "^10.0.0"
  }
}
