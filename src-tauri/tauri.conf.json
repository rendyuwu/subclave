{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subclave",
  "mainBinaryName": "SubclaveApp",
  "version": "0.2.0",
  "identifier": "dev.rendy.subclave",
  "build": {
    "beforeDevCommand": "pnpm build:sidecar:dev && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:sidecar && pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Subclave",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/subclave-proxy"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator-gtk3"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "category": "Utility",
    "copyright": "Copyright © 2026 rendyuwu. Derived from Tervia © 2026 rendyuwu, TEDI © 2026 IlhamriSKY and Terax © 2026 Crynta. Apache License 2.0.",
    "licenseFile": "../LICENSE",
    "shortDescription": "Local-first password manager",
    "longDescription": "Subclave is a local-first desktop password vault with end-to-end encrypted sync to storage you own."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rendyuwu/subclave/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5NEZEMkU4QTM2QjQ5QzkKUldUSlNXdWo2TkpQcVlzUXlIczI1TlE3QlVuTXJ3YXJKUW5ZOGRQUGFlVjZvenNNUzFPK1lMcGMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
